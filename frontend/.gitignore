# Third-party and generated: godot-cpp is downloaded (10.0.0-stable), the rest is rebuilt by gdext/build.py or Godot.
gdext/godot-cpp/
gdext/build/
godot/bin/
godot/.godot/
# The original game's art, fonts and sounds: local only (frontend/tools/import_original_assets.py), never in Git.
godot/assets/original/
# Their HD replacements (T050-C, frontend/tools/make_hd.py): made from the original art, so local only as well.
godot/assets/hd/
dist/
# Source Han Sans (SIL OFL 1.1, downloaded 2026-10-23 for the Chinese glyphs; tools/make_cjk_font.py) and the
# languages' texts, glyph atlases and localised pictures (derived from the original's texts and art): local only.
tools/fonts/
godot/assets/lang/

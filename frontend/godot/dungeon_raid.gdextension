macos.release = "res://bin/libdungeonraid.macos.template_debug.arm64.dylib"
ios.debug = "res://bin/libdungeonraid.ios.template_debug.xcframework"
ios.release = "res://bin/libdungeonraid.ios.template_debug.xcframework"

; Engine configuration file.
; Dungeon Raid remake (T050-A). The rules and the original game's drawing run in the native library
; (dungeon_raid.gdextension, built by frontend/gdext/build.py); original.tscn paints that drawing and passes input
; (main.tscn is the earlier prototype with simple shapes). The name keeps the saves' folder (user://).

config_version=5

[application]

config/name="Dungeon Raid 原型"
run/main_scene="res://original.tscn"
config/features=PackedStringArray("4.5")

[display]

window/size/viewport_width=640
window/size/viewport_height=960
window/size/window_width_override=520
window/size/window_height_override=780
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

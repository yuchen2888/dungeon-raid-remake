; Engine configuration file.
; Dungeon Raid remake (T050-A). The rules and the original game's drawing run in the native library
; (dungeon_raid.gdextension, built by frontend/gdext/build.py); original.tscn paints that drawing and passes input
; (main.tscn is the earlier prototype with simple shapes). The name keeps the saves' folder (user://).

config_version=5

[application]

config/name="Dungeon Raid 原型"
run/main_scene="res://original.tscn"
config/features=PackedStringArray("4.5")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/hd/Default.png"
; (T050-I) the launch picture (frontend/tools/make_splash.py: sharp, from the HD art) at the screen's width, where the main
; menu then appears (it showed at its 320-pixel size first, then the game jumped to full width)
boot_splash/stretch_mode=1

[audio]

; (T050-H) iOS: the media channel like other games and videos, so the ring/silent switch does not mute the game and the
; volume buttons set the media volume; other apps' music keeps playing alongside
general/ios/session_category=3
general/ios/mix_with_others=true

[display]

window/size/viewport_width=640
window/size/viewport_height=960
window/size/window_width_override=520
window/size/window_height_override=780
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
